  },
  "actionTransformSignatures": {
    "DepositCurrency": {
      "category": "acquire",
      "parameters": {
        "slot": {
          "type": "int32",
          "required": true,
          "description": "GS2 Money2 wallet slot. The Wallet whose id is the slot as a decimal string (slot 0 is \"0\") shows its balance; no Wallet row is needed. Free and paid balances are separate per slot."
        },
        "count": {
          "type": "int32",
          "required": true,
          "description": "Amount of currency to deposit; it is paid currency when price > 0."
        },
        "currencyType": {
          "type": "string",
          "required": true,
          "description": "ISO currency code of the purchase price, such as JPY; used only when price > 0."
        },
        "price": {
          "type": "float64",
          "required": true,
          "description": "Purchase price in currencyType; GS2 Money2 treats a deposit with price 0 as free currency."
        }
      }
    },
    "DepositFreeCurrency": {
      "category": "acquire",
      "parameters": {
        "slot": {
          "type": "int32",
          "required": true,
          "description": "GS2 Money2 wallet slot. The Wallet whose id is the slot as a decimal string (slot 0 is \"0\") shows its balance; no Wallet row is needed. Free and paid balances are separate per slot."
        },
        "count": {
          "type": "int32",
          "required": true,
          "description": "Amount of free currency to deposit (price 0)."
        }
      }
    },
    "VerifyReceipt": {
      "category": "consume",
      "parameters": {
        "contentName": {
          "type": "ref<StoreProduct>",
          "required": true,
          "description": "StoreProduct id, which is the GS2 Money2 store content model name."
        }
      }
    },
    "WithdrawCurrency": {
      "category": "consume",
      "parameters": {
        "slot": {
          "type": "int32",
          "required": true,
          "description": "GS2 Money2 wallet slot. The Wallet whose id is the slot as a decimal string (slot 0 is \"0\") shows its balance; no Wallet row is needed. Free and paid balances are separate per slot."
        },
        "paidOnly": {
          "type": "bool",
          "required": false,
          "description": "When true, only paid currency is withdrawn; otherwise free currency is used first (the namespace sets PrioritizeFree)."
        },
        "count": {
          "type": "int32",
          "required": true,
          "description": "Amount of currency to withdraw."
        }
      }
    },
    "WithdrawPaidCurrency": {
      "category": "consume",
      "parameters": {
        "slot": {
          "type": "int32",
          "required": true,
          "description": "GS2 Money2 wallet slot. The Wallet whose id is the slot as a decimal string (slot 0 is \"0\") shows its balance; no Wallet row is needed. Free and paid balances are separate per slot."
        },
        "count": {
          "type": "int32",
          "required": true,
          "description": "Amount of paid currency to withdraw."
        }
      }
    }
  },
