      "propertyDetails": {
        "currentMaximumValue": {
          "type": "int32",
          "requirement": "always",
          "bindingHint": "userData",
          "display": {
            "en": {
              "label": "Current maximum",
              "description": "Stamina capacity currently applied to the player (GS2 Stamina maxValue). Time-based recovery stops at this value.",
              "unit": "points"
            },
            "ja": {
              "label": "現在の上限",
              "description": "プレイヤーに適用されている現在のスタミナ上限（GS2 Stamina の maxValue）です。時間経過による回復はこの値で止まります。",
              "unit": "ポイント"
            }
          }
        },
        "currentValue": {
          "type": "int32",
          "requirement": "always",
          "bindingHint": "userData",
          "display": {
            "en": {
              "label": "Current value",
              "description": "Player's current stamina (GS2 Stamina value), excluding any overflow held above the current maximum. The overflow amount is not exposed by this type.",
              "unit": "points"
            },
            "ja": {
              "label": "現在値",
              "description": "プレイヤーが現在持っているスタミナ（GS2 Stamina の value）です。上限超過で保持している分は含まず、超過分はこの型では参照できません。",
              "unit": "ポイント"
            }
          }
        },
        "defaultMaximum": {
