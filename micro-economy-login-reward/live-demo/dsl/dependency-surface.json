      "propertyDetails": {
        "id": {
          "type": "string",
          "requirement": "always",
          "bindingHint": "none",
          "display": {
            "en": {
              "label": "ID",
              "description": "Uniquely identifies the login reward group."
            },
            "ja": {
              "label": "ID",
              "description": "ログインボーナスグループを一意に識別します。"
            }
          }
        },
        "lastReceivedAt": {
          "type": "timestamp",
          "requirement": "never",
          "bindingHint": "userData",
          "display": {
            "en": {
              "label": "Last received at",
              "description": "When the player last claimed a reward."
            },
            "ja": {
              "label": "最終受取日時",
              "description": "プレイヤーが最後に報酬を受け取った日時です。"
            }
          }
        },
        "missedReceiveRelief": {
          "type": "enum<enabled|disabled>",
          "requirement": "never",
          "bindingHint": "masterData",
          "display": {
            "en": {
              "label": "Missed-receive relief",
              "description": "Lets a player claim a missed step in exchange for the relief consume actions. In schedule mode the step to claim must be given."
            },
            "ja": {
              "label": "取り逃し救済",
              "description": "受け取り損ねた段階を、救済の消費アクションと引き換えに受け取れるようにします。schedule では受け取る段階の指定が必要です。"
            }
          }
        },
        "missedReceiveReliefConsumeActions": {
          "type": "list<consumeAction>",
          "requirement": "never",
          "bindingHint": "masterData",
          "display": {
            "en": {
              "label": "Relief consume actions",
              "description": "Consume actions executed when claiming a missed step."
            },
            "ja": {
              "label": "救済の消費アクション",
              "description": "取り逃した段階を受け取るときに実行する消費アクションです。"
            }
          }
        },
        "mode": {
          "type": "enum<schedule|streaming>",
          "requirement": "always",
          "bindingHint": "masterData",
          "display": {
            "en": {
              "label": "Progress mode",
              "description": "schedule picks the step by days since the schedule started; streaming by days claimed."
            },
            "ja": {
              "label": "進行モード",
              "description": "schedule は開催開始からの日数で、streaming は受け取った日数で段階を決めます。"
            }
          }
        },
        "receivedSteps": {
          "type": "list<bool>",
          "requirement": "never",
          "bindingHint": "userData",
          "display": {
            "en": {
              "label": "Received steps",
              "description": "Steps the player has claimed, in step order."
            },
            "ja": {
              "label": "受取済み段階",
              "description": "プレイヤーが受け取り済みの段階を、先頭から順に示します。"
            }
          }
        },
        "repeat": {
          "type": "enum<enabled|disabled>",
          "requirement": "conditional",
          "bindingHint": "masterData",
          "display": {
            "en": {
              "label": "Repeat",
              "description": "Whether streaming returns to the first step after the last one is claimed. Missed-receive relief is unavailable while it is enabled."
            },
            "ja": {
              "label": "繰り返し",
              "description": "streaming で最後の段階まで受け取った後、最初の段階へ戻るかどうかです。有効にすると取り逃し救済は使えません。"
            }
          }
        },
        "resetHour": {
          "type": "int32",
          "requirement": "conditional",
          "bindingHint": "masterData",
          "display": {
            "en": {
              "label": "Daily reset hour",
              "description": "UTC hour when streaming moves on to the next day. Not used when a schedule is set.",
              "unit": "hour"
            },
            "ja": {
              "label": "日付更新時刻",
              "description": "streaming で受け取り日を次の日へ進めるUTC時刻です。開催スケジュールを指定したときは使われません。",
              "unit": "時"
            }
          }
        },
        "schedule": {
          "type": "ref<foundation-economy-schedule:Schedule>",
          "requirement": "conditional",
          "bindingHint": "assetDelivery",
          "display": {
            "en": {
              "label": "Availability schedule",
              "description": "Schedule during which this login reward is available."
            },
            "ja": {
              "label": "開催スケジュール",
              "description": "このログインボーナスを開催するスケジュールです。"
            }
          }
        }
